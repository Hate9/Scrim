{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrim",
  "mainBinaryName": "scrim",
  "version": "1.0.0",
  "identifier": "io.gitlab.sistersvibecode.Scrim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' tauri:",
        "script-src": "'self' tauri:",
        "img-src": "* data: blob: scrim-file:",
        "media-src": "* data: blob: scrim-file:",
        "style-src": "'self' 'unsafe-inline' tauri: scrim-file: https:",
        "font-src": "'self' data: scrim-file: https:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "scrim-embed:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Live-preview Markdown editor",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "mimeType": "text/markdown",
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "longDescription": "Scrim is a live-preview Markdown editor for Linux and Windows: Markdown renders as you type and the file on disk stays plain Markdown.",
    "linux": {
      "deb": {
        "recommends": [
          "hunspell-en-us"
        ],
        "section": "editors",
        "desktopTemplate": "../packaging/linux/scrim.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Scrim developers",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE"
  }
}
