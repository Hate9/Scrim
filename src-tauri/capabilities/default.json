{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for document windows",
  "windows": ["doc-*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "dialog:allow-message",
    "dialog:allow-ask"
  ]
}
